# Never commit keyboxes: they carry private keys, and a published one gets revoked fast.
# The keybox tests read real files from tests/.../data locally and skip when they're absent.
*.keybox
keybox*.xml
tests/**/data/keybox-*.xml
# real partition tables from the test phone (device-specific GUIDs): local only
tests/**/data/lun4-*.bin
