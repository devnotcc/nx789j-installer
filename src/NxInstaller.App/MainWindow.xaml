<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NxInstaller.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NxInstaller.App"
    Title="REDMAGIC 10 Pro Installer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar -->
        <StackPanel x:Name="TitleBar" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Padding="14,0,0,0" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8EA;" FontSize="13" />
            <TextBlock Text="REDMAGIC 10 Pro Installer" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Text="Preview" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Left rail -->
        <Grid Grid.Row="1" Padding="20,20,12,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ItemsControl x:Name="StepList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:StepItem">
                        <Grid Height="46" Background="Transparent" Tapped="Step_Tapped" Tag="{x:Bind Index}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- connector line to the next step -->
                            <Rectangle Width="2" Height="24" Margin="0,34,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                                       Fill="{x:Bind LineBrush, Mode=OneWay}" Visibility="{x:Bind LineVisibility}" />
                            <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,4,0,0">
                                <Ellipse Fill="{x:Bind CircleFill, Mode=OneWay}" Stroke="{x:Bind CircleStroke, Mode=OneWay}" StrokeThickness="1.5" />
                                <TextBlock Text="{x:Bind Number}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{x:Bind NumberVisibility, Mode=OneWay}" Foreground="{x:Bind NumberBrush, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                          Visibility="{x:Bind CheckVisibility, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" Margin="12,6,0,0" VerticalAlignment="Top"
                                       FontWeight="{x:Bind Weight, Mode=OneWay}" Opacity="{x:Bind TextOpacity, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Phone card -->
            <Border Grid.Row="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="PhoneIcon" Glyph="&#xE8EA;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="PhoneTitle" Text="No phone yet" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PhoneDetail" Text="Looking for it…" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="2">
                <Button x:Name="ToolsButton" Click="Tools_Click" Style="{StaticResource SidebarButton}" AutomationProperties.Name="Device tools">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE90F;" FontSize="15" />
                        <TextBlock Text="Device tools" />
                    </StackPanel>
                </Button>
                <Button x:Name="AboutButton" Click="About_Click" Style="{StaticResource SidebarButton}" AutomationProperties.Name="About">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;" FontSize="15" />
                        <TextBlock Text="About" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Grid.Column="1" CornerRadius="8,0,0,0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Frame x:Name="ContentFrame" />

            <Grid x:Name="BottomBar" Grid.Row="1" Padding="44,14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StepCounter" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="BackButton" Content="Back" MinWidth="96" Click="Back_Click" />
                    <Button x:Name="NextButton" Content="Get started" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Click="Next_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ToolsBar" Grid.Row="1" Padding="44,14" Visibility="Collapsed"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <HyperlinkButton Content="Back to setup" Click="BackToSetup_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
