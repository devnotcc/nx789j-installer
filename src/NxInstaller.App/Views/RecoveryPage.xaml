<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NxInstaller.App.Views.RecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NxInstaller.App.Views">

    <ScrollViewer>
        <local:PageStack Style="{StaticResource PageRoot}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Recovery and restart" />
            <TextBlock Style="{StaticResource PageIntro}" Text="Restart the phone into another mode, or repair one that won't start." />

            <TextBlock Text="Restart into" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="Recovery (TWRP)" Tag="recovery" Click="Reboot_Click" />
                <Button Content="EDL mode" Tag="edl" Click="Reboot_Click" />
                <Button Content="Bootloader" Tag="bootloader" Click="Reboot_Click" />
                <Button Content="System" Tag="" Click="Reboot_Click" />
            </StackPanel>
            <TextBlock Text="Needs the phone booted with USB debugging on, or in TWRP." Opacity="0.7"
                       Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,28" />

            <TextBlock Text="Repair" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,10" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Fix a phone that only starts into fastboot" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="After several failed starts the bootloader marks the slot as unbootable and only fastboot comes up. This clears that mark in both copies of the partition table. Nothing else changes: your system and data stay." />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="Put the phone in EDL mode first: power it off, hold both volume buttons and plug in the cable." />
                    <Button x:Name="RepairButton" Content="Repair the slot" Click="Repair_Click" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Put the kernel back" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="Rewrites only the boot and init_boot partitions with the ones from an OS package, for example after a custom kernel that doesn't start. Apps and data stay." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <ComboBox x:Name="KernelPackage" MinWidth="260" PlaceholderText="Pick the installed OS" />
                        <Button x:Name="KernelButton" Content="Put the kernel back" Click="Kernel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <CheckBox x:Name="Dry" Content="Test run: go through the steps but write nothing" Margin="0,0,0,12" />

            <StackPanel x:Name="ProgressArea" Spacing="8" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock x:Name="StepText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar x:Name="Bar" IsIndeterminate="True" Height="6" />
            </StackPanel>
            <InfoBar x:Name="Message" IsClosable="True" />
        </local:PageStack>
    </ScrollViewer>
</Page>
