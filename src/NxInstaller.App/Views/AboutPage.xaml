<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NxInstaller.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NxInstaller.App.Views">

    <ScrollViewer>
        <local:PageStack Style="{StaticResource PageRoot}">
            <Border Style="{StaticResource HeroIcon}">
                <FontIcon Glyph="&#xE8EA;" FontSize="26" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <TextBlock Style="{StaticResource PageTitle}" Text="REDMAGIC 10 Pro Installer" />
            <TextBlock x:Name="Version" Opacity="0.75" Margin="0,0,0,24" />

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Community software for the nubia REDMAGIC 10 Pro (NX789J). Not made, endorsed or supported by nubia, ZTE, Google or Qualcomm." />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,24" Opacity="0.85"
                       Text="Not included and never redistributed: Qualcomm's EDL tools and the firehose loader (from your ZTE toolbox), Google's platform-tools (downloaded from Google), keyboxes (you provide your own), Windows (you provide the ISO)." />

            <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Padding="0,10">
                        <StackPanel Spacing="2" Margin="0,0,140,0">
                            <TextBlock Text="Logs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Attach the latest one to a bug report." Opacity="0.8" />
                        </StackPanel>
                        <Button Content="Open folder" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Logs_Click" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,10">
                        <StackPanel Spacing="2" Margin="0,0,140,0">
                            <TextBlock Text="Package repository" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="Repo" Margin="0,4,0,0" PlaceholderText="owner/name" />
                        </StackPanel>
                        <Button Content="Save" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Repo_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </local:PageStack>
    </ScrollViewer>
</Page>
