<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NxInstaller.App.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NxInstaller.App.Views">

    <ScrollViewer>
        <local:PageStack Style="{StaticResource PageRoot}">
            <Border x:Name="Hero" Style="{StaticResource HeroIcon}">
                <FontIcon x:Name="HeroGlyph" Glyph="&#xE896;" FontSize="26" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Intro" Style="{StaticResource PageIntro}" />

            <StackPanel x:Name="ProgressArea" Spacing="10" Visibility="Collapsed" Margin="0,0,0,24">
                <Grid>
                    <TextBlock x:Name="StepText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="Percent" HorizontalAlignment="Right" Opacity="0.7" />
                </Grid>
                <ProgressBar x:Name="Bar" Maximum="1" Height="6" />
                <TextBlock x:Name="KeepConnected" TextWrapping="Wrap" Opacity="0.8"
                           Text="Keep the phone connected and don't touch its buttons until this finishes." />
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,4,0,0" />
            </StackPanel>

            <InfoBar x:Name="Result" IsClosable="False" Margin="0,0,0,16" />

            <Expander x:Name="LogExpander" Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <ScrollViewer x:Name="LogScroll" MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                    <HyperlinkButton x:Name="OpenLog" Content="Open the full log" Click="OpenLog_Click" Padding="0" />
                </StackPanel>
            </Expander>
        </local:PageStack>
    </ScrollViewer>
</Page>
