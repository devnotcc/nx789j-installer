<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NxInstaller.App.Views.OptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NxInstaller.App.Views">

    <ScrollViewer>
        <local:PageStack Style="{StaticResource PageRoot}">
            <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" Text="Ready to install" />
            <TextBlock Style="{StaticResource PageIntro}" Text="Check the choices below. Nothing has been written to the phone yet." />

            <!-- Data -->
            <Border x:Name="WipeCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="6" VerticalAlignment="Top" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Everything on the phone will be erased" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="WipeReason" TextWrapping="Wrap" Opacity="0.85" />
                        <CheckBox x:Name="WipeConfirm" Content="Erase the phone's apps, photos and files" Checked="Changed" Unchecked="Changed" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="KeepCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Your apps and data stay" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="KeepReason" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>
                    <ToggleSwitch x:Name="EraseAnyway" Grid.Column="1" OnContent="Erase" OffContent="Keep" Toggled="Changed" />
                </Grid>
            </Border>

            <!-- Options -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,6">
                <StackPanel>
                    <Grid x:Name="TwrpRow" Padding="0,10">
                        <StackPanel Spacing="2" Margin="0,0,120,0">
                            <TextBlock Text="Install TWRP recovery" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="A recovery for backups and fixes when the phone won't start. Recommended." TextWrapping="Wrap" Opacity="0.8" />
                        </StackPanel>
                        <ToggleSwitch x:Name="Twrp" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                    <Rectangle x:Name="TwrpLine" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,10">
                        <StackPanel Spacing="2" Margin="0,0,120,0">
                            <TextBlock Text="Back up first" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Save the boot partitions being replaced to this PC, so they can be put back." TextWrapping="Wrap" Opacity="0.8" />
                        </StackPanel>
                        <ToggleSwitch x:Name="Backup" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- What gets written -->
            <Expander Header="What will be written" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                <StackPanel x:Name="WriteList" Spacing="6" />
            </Expander>

            <Expander Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid>
                    <StackPanel Spacing="2" Margin="0,0,120,0">
                        <TextBlock Text="Test run" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                   Text="Go through every step, including restarting into EDL and reading the lock state, but write nothing. The phone restarts back to its current system." />
                    </StackPanel>
                    <ToggleSwitch x:Name="Dry" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                </Grid>
            </Expander>
        </local:PageStack>
    </ScrollViewer>
</Page>
